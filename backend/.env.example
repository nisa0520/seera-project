# ============================================================
# Seera Chatbot Backend — environment (dev lokal: uvicorn)
# Dibaca pydantic-settings dari working dir backend/.
# Di Docker, nilai-nilai ini dioverride oleh environment compose.
# JANGAN commit file ini. Template: backend/.env.example
# ============================================================

# ---- Aplikasi ----
APP_NAME=Seera Chatbot API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Database ----
# Dev lokal memakai SQLite; untuk PostgreSQL (mis. dari docker compose postgres):
# DATABASE_URL=postgresql+psycopg2://seera:seera_pass@localhost:5432/seera_db
DATABASE_URL=sqlite:///./seera_chatbot.db

# ---- CORS (origin frontend dev) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---- Analisis image kulit (threshold; default sudah wajar) ----
IMAGE_MAX_UPLOAD_BYTES=5242880
IMAGE_CONFIDENCE_THRESHOLD=0.6

# ---- Realistic Virtual Try-On (PRD Revisi IDM-VTON yisol AssetTier) ----
# space = HuggingFace Space (asli) | http = worker GPU internal | mock = demo tanpa GPU
VTON_INFERENCE_MODE=space
# Provider resmi IDM-VTON (PRD 15.2). Model default = IDM-VTON (garment fidelity);
# fallback otomatis = CatVTON.
VTON_MODEL_PROVIDER=yisol
VTON_MODEL_NAME=IDM-VTON
VTON_MODEL_REPO=yisol/IDM-VTON
VTON_SPACE_ID=yisol/IDM-VTON
VTON_MODEL_DEFAULT=idm-vton
VTON_MODEL_VERSION=idm-vton-prototype
VTON_FALLBACK_MODEL=catvton
VTON_GARMENT_FIDELITY_PRIORITY=true
VTON_CATVTON_SPACE_ID=zhengchong/CatVTON
# Token HuggingFace (kuota GPU lebih besar): https://huggingface.co/settings/tokens
VTON_HF_TOKEN=
# URL worker GPU internal bila VTON_INFERENCE_MODE=http
VTON_HTTP_URL=
VTON_INFERENCE_RESOLUTION=768x1024
# IDM-VTON (default)
VTON_IDM_DENOISE_STEPS=30
VTON_IDM_AUTO_CROP=false
# CatVTON (fallback)
VTON_NUM_INFERENCE_STEPS=50
VTON_GUIDANCE_SCALE=2.5
VTON_SEED=42
VTON_TIMEOUT_SECONDS=300
VTON_MAX_JOBS_PER_SESSION=5
VTON_TEMP_DIR=/tmp/seera_vton
VTON_IMAGE_TTL_MINUTES=60
# ---- VTON Asset Eligibility Tier & experimental mode ----
VTON_ALLOW_EXPERIMENTAL_ASSET_MODE=true
VTON_BLOCK_UNSUPPORTED_ASSETS=true
# Artefak debug (bukti gambar yang dikirim ke model) per job.
VTON_ENABLE_DEBUG_ARTIFACTS=true
VTON_DEBUG_DIR=storage/vton_debug
# Lisensi IDM-VTON/CatVTON non-komersial: prototipe akademik saja
VTON_COMMERCIAL_DEPLOYMENT_ALLOWED=false
