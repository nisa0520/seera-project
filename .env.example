# ============================================================
# Seera Project — environment root
# Dipakai oleh: docker-compose (substitusi variabel) & Vite dev
# JANGAN commit file ini (sudah di-.gitignore). Template: .env.example
# ============================================================

# ---- Frontend (Vite dev: npm run dev) ----
# Base URL API backend. Kosongkan ("") bila lewat nginx Docker (proxy /api).
VITE_API_BASE_URL=http://localhost:8000

# ---- Realistic Virtual Try-On (docker-compose backend) ----
# PRD Revisi: model default = IDM-VTON (garment fidelity), fallback = CatVTON.
# Mode inference:
#   space = HuggingFace Space (model asli; butuh internet + kuota GPU)
#   http  = worker GPU internal (set VTON_HTTP_URL di backend/.env)
#   mock  = kompositor lokal tanpa GPU (demo offline selalu jalan)
VTON_INFERENCE_MODE=space

# Token HuggingFace untuk kuota ZeroGPU lebih besar (huggingface.co/settings/tokens).
# Tanpa token, kuota anonim hanya cukup ±1 inference per hari per IP.
VTON_HF_TOKEN=

# Provider resmi IDM-VTON (default) + fallback CatVTON.
VTON_MODEL_PROVIDER=yisol
VTON_MODEL_REPO=yisol/IDM-VTON
VTON_SPACE_ID=yisol/IDM-VTON
VTON_FALLBACK_MODEL=catvton
# VTON Asset Eligibility Tier: izinkan produk foto seadanya (experimental/limited),
# blokir aset tidak layak, simpan artefak debug bukti gambar yang dikirim ke model.
VTON_ALLOW_EXPERIMENTAL_ASSET_MODE=true
VTON_BLOCK_UNSUPPORTED_ASSETS=true
VTON_ENABLE_DEBUG_ARTIFACTS=true
